# ============================================================
# Shared ASV number: NN / PN / PP
# Parent + Mother + Father 三个panel
# ============================================================

col_hp <- c("NN" = "#F8C48C", "PN" = "#C7B7E5", "PP" = "#A2D9B1")
pair_comparisons <- list(c("NN", "PN"), c("NN", "PP"), c("PN", "PP"))

plot_shared_asv <- function(family_pairs, site_name) {
    
    parent_base <- family_pairs %>%
        filter(Relationship %in% c("Mother–offspring", "Father–offspring")) %>%
        mutate(Hp_Pair3 = factor(Hp_Pair3, levels = c("NN", "PN", "PP")))
    
    plot_df <- bind_rows(
        parent_base %>% mutate(Panel = "Parent–offspring"),
        parent_base %>% filter(Relationship == "Mother–offspring") %>% mutate(Panel = "Mother–offspring"),
        parent_base %>% filter(Relationship == "Father–offspring") %>% mutate(Panel = "Father–offspring")
    ) %>%
        mutate(
            Panel = factor(Panel, levels = c("Parent–offspring", "Mother–offspring", "Father–offspring")),
            Hp_Positive_N = case_when(Hp_Pair3 == "NN" ~ 0, Hp_Pair3 == "PN" ~ 1, Hp_Pair3 == "PP" ~ 2)
        )
    
    # ==========================================================
    # 统计结果
    # ==========================================================
    
    summary_df <- plot_df %>%
        group_by(Panel, Hp_Pair3) %>%
        summarise(n = n(), median = median(Shared_ASV, na.rm = TRUE),
                  Q1 = quantile(Shared_ASV, 0.25, na.rm = TRUE),
                  Q3 = quantile(Shared_ASV, 0.75, na.rm = TRUE), .groups = "drop")
    
    kw_p <- plot_df %>%
        group_by(Panel) %>%
        group_modify(~{
            tt <- kruskal.test(Shared_ASV ~ Hp_Pair3, data = .x)
            tibble(KW_p = tt$p.value)
        }) %>% ungroup()
    
    pairwise_p <- plot_df %>%
        group_by(Panel) %>%
        group_modify(~{
            map_dfr(pair_comparisons, function(cp) {
                x <- .x %>% filter(Hp_Pair3 == cp[1]) %>% pull(Shared_ASV)
                y <- .x %>% filter(Hp_Pair3 == cp[2]) %>% pull(Shared_ASV)
                wt <- wilcox.test(x, y, exact = FALSE)
                tibble(comparison = paste(cp[1], "vs", cp[2]), p_value = wt$p.value)
            })
        }) %>% ungroup()
    
    trend_p <- plot_df %>%
        group_by(Panel) %>%
        group_modify(~{
            jt <- suppressWarnings(jonckheere.test(.x$Shared_ASV, .x$Hp_Positive_N, alternative = "increasing"))
            tibble(P_trend = jt$p.value)
        }) %>% ungroup()
    
    cat("\n====================================================\n")
    cat(site_name, ": Shared ASV number\n")
    cat("====================================================\n\n")
    print(summary_df)
    cat("\nKruskal-Wallis P values:\n"); print(kw_p)
    cat("\nPairwise Wilcoxon P values:\n"); print(pairwise_p)
    cat("\nP for trend:\n"); print(trend_p)
    
    # ==========================================================
    # P for trend位置
    # ==========================================================
    
    trend_label <- plot_df %>%
        group_by(Panel) %>%
        summarise(y = max(Shared_ASV, na.rm = TRUE) * 1.34, .groups = "drop") %>%
        left_join(trend_p, by = "Panel") %>%
        mutate(x = 2, label = paste0("P for trend = ", format.pval(P_trend, digits = 3, eps = 0.001)))
    
    # ==========================================================
    # 作图
    # ==========================================================
    
    p <- ggplot(plot_df, aes(x = Hp_Pair3, y = Shared_ASV, fill = Hp_Pair3, color = Hp_Pair3)) +
        geom_violin(width = 0.65, alpha = 0.60, linewidth = 0.4, trim = TRUE) +
        geom_boxplot(width = 0.14, alpha = 0.85, outlier.shape = NA, linewidth = 0.4, color = "#444444") +
        stat_compare_means(comparisons = pair_comparisons, method = "wilcox.test",
                           label = "p.format", step.increase = 0.08, tip.length = 0.015, size = 3.5) +
        geom_text(data = trend_label, aes(x = x, y = y, label = label),
                  inherit.aes = FALSE, size = 3.7, fontface = "bold") +
        facet_wrap(~Panel, nrow = 1) +
        scale_fill_manual(values = col_hp) +
        scale_color_manual(values = col_hp) +
        labs(title = site_name, x = NULL, y = "Number of shared ASVs") +
        theme_bw(base_size = 12) +
        theme(panel.grid = element_blank(), legend.position = "none",
              strip.text = element_text(size = 11, face = "bold"),
              plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
              axis.text.x = element_text(size = 10, color = "black"),
              axis.text.y = element_text(size = 10, color = "black"),
              axis.title.y = element_text(size = 11, face = "bold"))
    
    return(list(plot = p, summary = summary_df, kw_p = kw_p,
                pairwise_p = pairwise_p, trend_p = trend_p, data = plot_df))
}

