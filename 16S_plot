# 2. 严格年龄判定函数 (定义好的函数直接复用)
get_pair_age_group <- function(pair_type, m1_typ, m2_typ, a1, a2) {
  if (is.na(pair_type) | is.na(m1_typ) | is.na(m2_typ)) return(NA_character_)
  
  if (pair_type %in% c("Mother_offspring", "Father_offspring")) {
    child_age <- if (m1_typ %in% c("m", "f")) a2 else if (m2_typ %in% c("m", "f")) a1 else NA_character_
    if (is.na(child_age)) return(NA_character_)
    if (child_age == "children") return("Underage")
    if (child_age == "adult") return("Grown-up")
    return(NA_character_)
  }
  
  if (pair_type == "Sibling") {
    if (is.na(a1) | is.na(a2)) return(NA_character_)
    if (a1 == "children" & a2 == "children") return("Underage")
    if (a1 == "adult" & a2 == "adult") return("Grown-up")
    return(NA_character_)
  }
  return(NA_character_)
}

