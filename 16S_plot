#基于属水平做口腔bray-curtis距离的计算
library(vegan)
library(ape)
library(phyloseq)
library(tidyverse)
library(readxl)
library(ggpubr)
library(RColorBrewer)
library(ggsignif)

# ==========================================
# 步骤 0：【核心修正】在计算 Beta 多样性前，先严格对齐样本 (1664个)
# ==========================================
oral.16s.abun.1 <- oral.16s.abun.genus
rownames(oral.16s.abun.1) <- oral.16s.abun.1$Taxa
oral.16s.abun.1 <- oral.16s.abun.1[, -1] # 移除 Taxa 列，只留样本列

# 1. 获取 Metadata 与 丰度表 共同存在的 1664 个样本 ID
common_samples <- intersect(colnames(oral.16s.abun.1), oral.16s.meta$ID2)

# 2. 筛选丰度表和 Metadata，只保留这 1664 个样本
oral.16s.abun.filtered <- oral.16s.abun.1[, common_samples]
oral.16s.meta_clean   <- oral.16s.meta %>% filter(ID2 %in% common_samples)


# ==========================================
# 步骤 1：基于对齐后的 1664 个样本计算 Beta 多样性
# ==========================================
b.diversity <- function(count) {
  count <- as.data.frame(count)
  count <- as.data.frame(t(count)) # 转换成列为物种，行为样本
  dis.mat <- list()
  dis.mat[["bray"]] <- as.data.frame(as.matrix(vegdist(count, method = "bray")))
  dis.mat[["euclidean"]] <- as.data.frame(as.matrix(vegdist(count, method = "euclidean")))
  dis.mat[["jaccard"]] <- as.data.frame(as.matrix(vegdist(count, method = "jaccard", binary = TRUE)))
  return(dis.mat)
}

# 使用过滤后的丰度表计算
oral.16s.beta <- b.diversity(oral.16s.abun.filtered)

# ==========================================
# 步骤 2：整理 Bray-Curtis 距离矩阵并匹配亲属关系
# ==========================================
oral.16s.beta.long <- oral.16s.beta[["bray"]]
oral.16s.beta.long$Sample1 <- rownames(oral.16s.beta.long)
oral.16s.beta.long <- pivot_longer(oral.16s.beta.long, cols = -Sample1, names_to = "Sample2", values_to = "Distance")

# 1. 剔除自身配对，并进行无方向全局去重 (解决双向重复计数问题)
oral.16s.beta.long <- oral.16s.beta.long %>% 
  filter(Sample1 != Sample2) %>%
  mutate(pair_id = paste(pmin(Sample1, Sample2), pmax(Sample1, Sample2), sep = "___")) %>%
  distinct(pair_id, .keep_all = TRUE)

# 2. 合并家庭 ID，区分组间/组内家庭 (使用 select 避免多重 left_join 列名冲突)
oral.16s.beta.long <- oral.16s.beta.long %>%
  left_join(oral.16s.meta_clean %>% select(ID2, Family1 = Family), by = c("Sample1" = "ID2")) %>%
  left_join(oral.16s.meta_clean %>% select(ID2, Family2 = Family), by = c("Sample2" = "ID2")) %>%
  mutate(Family = ifelse(Family1 == Family2, "Within", "Between"))

# 3. 提取组间 (Between-family)
oral.16s.between <- oral.16s.beta.long %>%
  filter(Family == "Between") %>%
  mutate(Group = "Between-family") %>%
  select(Distance, Group)

# 4. 家庭内部配对：提取并判定亲属关系类型
oral.16s.within <- oral.16s.beta.long %>% filter(Family == "Within")

# 读取亲属配对关系对照表
membership <- read_xlsx("Input/Membership.xlsx")
membership$Group1[is.na(membership$Group1)] <- "Other"
membership$Group2[is.na(membership$Group2)] <- "Other"

membership_all <- bind_rows(
  membership %>% select(Membership1, Membership2, Group1) %>% rename(M1 = Membership1, M2 = Membership2, Group = Group1),
  membership %>% select(Membership2, Membership1, Group2) %>% rename(M1 = Membership2, M2 = Membership1, Group = Group2)
) %>% distinct(M1, M2, .keep_all = TRUE)

# 匹配亲属分组 (使用 oral.16s.meta_clean)
oral.16s.within <- oral.16s.within %>%
  left_join(oral.16s.meta_clean %>% select(ID2, M1 = Membership), by = c("Sample1" = "ID2")) %>%
  left_join(oral.16s.meta_clean %>% select(ID2, M2 = Membership), by = c("Sample2" = "ID2")) %>%
  left_join(membership_all, by = c("M1", "M2")) %>%
  mutate(Group = case_when(
    Group == "Spouse" ~ "Spouse",
    Group == "Mother_offspring" ~ "Mother-offspring",
    Group == "Father_offspring" ~ "Father-offspring",
    Group == "Sibling" ~ "Sibling",
    Group == "Grandparent_grandchild" ~ "Grandparent-grandchild",
    TRUE ~ NA_character_
  )) %>%
  filter(!is.na(Group)) %>%
  select(Distance, Group)

# 5. 合并绘图数据
plot_df_oral <- bind_rows(oral.16s.between, oral.16s.within)

# 固定分组顺序
group_levels <- c("Between-family", "Within-family", "Spouse", "Mother-offspring", "Father-offspring", "Sibling", "Grandparent-grandchild")

within_all_oral <- plot_df_oral %>% filter(Group != "Between-family") %>% mutate(Group = "Within-family")
plot_df_oral <- bind_rows(plot_df_oral, within_all_oral) %>%
  mutate(Group = factor(Group, levels = group_levels))

# 6. 统计样本量并生成 X 轴标签
group_n_oral <- plot_df_oral %>% count(Group) %>% mutate(label = paste0(Group, "\n(n=", n, ")"))
label_map_oral <- set_names(group_n_oral$label, group_n_oral$Group)

