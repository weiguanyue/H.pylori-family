# ==========================================
# 步骤 2：判断口腔每一组配对的年龄层级
# ==========================================
get_pair_age_group <- function(pair_type, m1_typ, m2_typ, a1, a2) {
  if (pair_type %in% c("Mother_offspring", "Father_offspring")) {
    child_age <- if (m1_typ %in% c("m", "f")) a2 else a1
    return(if (child_age == "children") "Underage" else "Grown-up")
  }
  
  if (pair_type == "Sibling") {
    if (a1 == "children" & a2 == "children") {
      return("Underage")
    } else if (a1 == "adult" & a2 == "adult") {
      return("Grown-up")
    } else {
      return(NA_character_)
    }
  }
  
  return(NA_character_)
}

