process_rel_hp <- function(share_df_data, meta_data, tissue_name) {
  
  # A. 提取配对 + 匹配亲属关系 + 匹配双人 Hp 状态
  paired_hp <- share_df_data %>%
    left_join(meta_data %>% select(ID2, Fam1 = Family, M1 = Membership, Hp1 = Hp), by = c("Sample1" = "ID2")) %>%
    left_join(meta_data %>% select(ID2, Fam2 = Family, M2 = Membership, Hp2 = Hp), by = c("Sample2" = "ID2")) %>%
    filter(!is.na(Fam1) & !is.na(Fam2) & Fam1 == Fam2) %>%
    left_join(mem_all, by = c("M1" = "m1", "M2" = "m2")) %>%
    filter(PairType %in% c("Mother_offspring", "Father_offspring", "Sibling")) %>%
    filter(!is.na(Hp1) & !is.na(Hp2) & Hp1 %in% c("Hp_P", "Hp_N") & Hp2 %in% c("Hp_P", "Hp_N")) %>%
    mutate(
      Hp_Pair_Group = case_when(
        Hp1 == "Hp_P" & Hp2 == "Hp_P" ~ "PP",
        Hp1 == "Hp_N" & Hp2 == "Hp_N" ~ "NN",
        TRUE ~ "PN"
      ),
      Hp_Pair_Group = factor(Hp_Pair_Group, levels = c("PP", "PN", "NN")),
      PairType = case_when(
        PairType == "Mother_offspring" ~ "Mother–offspring",
        PairType == "Father_offspring" ~ "Father–offspring",
        PairType == "Sibling" ~ "Sibling"
      ),
      PairType = factor(PairType, levels = c("Mother–offspring", "Father–offspring", "Sibling"))
    )
  
  # B. 统计各组配对样本量
  cat(paste0("\n=== ", tissue_name, " 亲属配对样本量统计 ===\n"))
  print(table(paired_hp$PairType, paired_hp$Hp_Pair_Group))
  
  # C. 循环绘制 3 张子图
  plot_list <- list()
  rel_types <- c("Mother–offspring", "Father–offspring", "Sibling")
  
  for (rel in rel_types) {
    sub_df <- paired_hp %>% filter(PairType == rel)
    
    p <- ggplot(sub_df, aes(x = Hp_Pair_Group, y = ASV_share_rate, fill = Hp_Pair_Group, color = Hp_Pair_Group)) +
      geom_violin(width = 0.6, alpha = 0.5, linewidth = 0.4, trim = TRUE) +
      geom_boxplot(width = 0.15, alpha = 0.8, outlier.shape = NA, linewidth = 0.4, color = "#444444") +
      stat_compare_means(
        comparisons = my_comparisons,
        method = "wilcox.test",
        label = "p.signif",
        step.increase = 0.08,
        size = 3.5,
        tip.length = 0.02
      ) +
      stat_compare_means(method = "kruskal.test", label.y = max(sub_df$ASV_share_rate, na.rm=TRUE) * 1.1) +
      scale_fill_manual(values = col_hp_pair) +
      scale_color_manual(values = col_hp_pair) +
      labs(title = paste0(tissue_name, ": ", rel), y = "ASV-sharing rate (%)", x = NULL) +
      theme_bw() +
      theme(
        panel.grid = element_blank(),
        plot.title = element_text(hjust = 0.5, size = 11, face = "bold"),
        axis.text.x = element_text(size = 10, color = "black"),
        axis.text.y = element_text(size = 10, color = "black"),
        legend.position = "none"
      )
    
    plot_list[[rel]] <- p
  }
  
  # D. 拼图并保存
  p_combined <- ggarrange(plotlist = plot_list, ncol = 3, nrow = 1)
  ggsave(paste0(tissue_name, "_ASV_sharing_by_Relationship_Hp.pdf"), plot = p_combined, width = 10.5, height = 4.2)
  
  return(p_combined)
}

