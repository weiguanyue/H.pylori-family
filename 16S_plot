# 读取原始肠道GUT-ASV丰度表
asv_raw <- read.delim("Input/Feces_16S_dada2_asv_table.tsv", sep = "\t", row.names = 1, check.names = FALSE)
stopifnot(all(vapply(asv_raw, is.numeric, logical(1))))

# 过滤：单个样本中 count >= 2 才视为检出；且该 ASV 必须在至少 2 个样本中可信检出
asv_bin_all <- t(as.matrix(asv_raw)) >= 2
keep_asv    <- colSums(asv_bin_all) >= 2
asv_clean   <- asv_raw[keep_asv, , drop = FALSE]

cat("原始 ASV 数：", nrow(asv_raw), " | 过滤后 ASV 数：", nrow(asv_clean), "\n")

# 保存过滤后的 ASV 表
write.table(asv_clean, file = "Output/gut_ASV_filter_counts_min2reads_min2samples.txt", sep = "\t", quote = FALSE, col.names = NA)

# 1. 构建最终二值矩阵 (count >= 2 视为检出)
# =========================================================
asv_bin      <- t(as.matrix(asv_clean)) >= 2
sample_vec   <- rownames(asv_bin)
total_sample <- nrow(asv_bin)

cat("样本数：", total_sample, " | ASV数：", ncol(asv_bin), "\n")
cat("理论配对数：", choose(total_sample, 2), "\n")

# 1. 各样本 Richness
richness_vec <- rowSums(asv_bin)

# =========================================================
# 2. 分块矩阵乘法计算两两 Shared ASV (底层 BLAS 极速版)
# =========================================================
shared_mat <- matrix(0, nrow = total_sample, ncol = total_sample, 
                     dimnames = list(sample_vec, sample_vec))

block_size <- 500L
start_vec  <- seq.int(from = 1L, to = ncol(asv_bin), by = block_size)

for (start_col in start_vec) {
  end_col <- min(start_col + block_size - 1L, ncol(asv_bin))
  
  # 提取小块并转为双精度浮点数，用于矩阵乘法
  block <- asv_bin[, start_col:end_col, drop = FALSE]
  storage.mode(block) <- "double"
  
  # 矩阵乘法累加交集: Block %*% t(Block)
  shared_mat <- shared_mat + tcrossprod(block)
  
  rm(block)
  gc(FALSE)
}

# =========================================================
# 3. 提取上三角矩阵并计算 Union 与 Jaccard 共享率
# =========================================================
pair_idx      <- which(upper.tri(shared_mat), arr.ind = TRUE)
shared_vec    <- shared_mat[pair_idx]
richness1_vec <- richness_vec[pair_idx[, 1]]
richness2_vec <- richness_vec[pair_idx[, 2]]

# 容斥原理算并集: Union = A + B - Intersect
union_vec     <- richness1_vec + richness2_vec - shared_vec

# 构建最终结果表
share_df <- tibble(
  Sample1        = sample_vec[pair_idx[, 1]],
  Sample2        = sample_vec[pair_idx[, 2]],
  Richness1      = as.integer(richness1_vec),
  Richness2      = as.integer(richness2_vec),
  Shared_ASV     = as.integer(shared_vec),
  Union_ASV      = as.integer(union_vec),
  ASV_share_rate = ifelse(union_vec == 0, NA_real_, (shared_vec / union_vec) * 100)
)

# 清理内存
