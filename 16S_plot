# 步骤 2：封装通用的数据清洗与年龄分层函数
# =========================================================
get_pair_age_group <- function(pair_type, m1_typ, m2_typ, a1, a2) {
    if (is.na(pair_type) | is.na(m1_typ) | is.na(m2_typ)) return(NA_character_)
    
    if (pair_type %in% c("Mother_offspring", "Father_offspring")) {
        child_age <- if (m1_typ %in% c("m", "f")) a2 else if (m2_typ %in% c("m", "f")) a1 else NA_character_
        if (is.na(child_age)) return(NA_character_)
        if (child_age == "children") return("Underage")
        if (child_age == "adult") return("Grown-up")
        return(NA_character_)
    }
    
    if (pair_type == "Sibling") {
        if (is.na(a1) | is.na(a2)) return(NA_character_)
        if (a1 == "children" & a2 == "children") return("Underage")
        if (a1 == "adult" & a2 == "adult") return("Grown-up")
        return(NA_character_)
    }
    return(NA_character_)
}

prepare_asv_plot_data <- function(share_df, meta_df, membership_excel) {
    # 匹配家庭信息
    share_long <- share_df %>%
        left_join(meta_df %>% select(ID2, Family1 = Family), by = c("Sample1" = "ID2")) %>%
        left_join(meta_df %>% select(ID2, Family2 = Family), by = c("Sample2" = "ID2")) %>%
        filter(!is.na(Family1) & !is.na(Family2) & Family1 == Family2) %>%
        left_join(meta_df %>% select(ID2, M1 = Membership, Age1 = Age2), by = c("Sample1" = "ID2")) %>%
        left_join(meta_df %>% select(ID2, M2 = Membership, Age2 = Age2), by = c("Sample2" = "ID2"))
    
    # 匹配亲属对照字典
    membership <- read_xlsx(membership_excel)
    membership$Group1[is.na(membership$Group1)] <- "Other"
    membership$Group2[is.na(membership$Group2)] <- "Other"
    
    mem_all <- bind_rows(
        membership %>% select(Membership1, Membership2, Group1) %>% rename(m1 = Membership1, m2 = Membership2, PairType = Group1),
        membership %>% select(Membership2, Membership1, Group2) %>% rename(m1 = Membership2, m2 = Membership1, PairType = Group2)
    ) %>% distinct(m1, m2, .keep_all = TRUE)
    
    # 标注亲属并判定年龄层级
    plot_clean <- share_long %>%
        left_join(mem_all, by = c("M1" = "m1", "M2" = "m2")) %>%
        filter(PairType %in% c("Mother_offspring", "Father_offspring", "Sibling")) %>%
        rowwise() %>%
        mutate(Age_Group = get_pair_age_group(PairType, M1, M2, Age1, Age2)) %>%
        ungroup() %>%
        filter(!is.na(Age_Group)) %>%
        mutate(
            PairType = factor(PairType, 
                              levels = c("Mother_offspring", "Father_offspring", "Sibling"),
                              labels = c("Mother–offspring", "Father–offspring", "Sibling")),
            Age_Group = factor(Age_Group, levels = c("Underage", "Grown-up"))
        )
    
    return(plot_clean)
}

