#口腔ASV共享
# =========================================================
# 1. 读取口腔 ASV 原始丰度表 (Saliva)
# =========================================================
# 行 = ASV，列 = 样本
asv_raw_oral <- read.delim("Input/Saliva_16S_dada2_asv_table-1664.tsv",sep = "\t",row.names = 1,check.names = FALSE)

# 确认所有样本列都是数值
stopifnot(all(vapply(asv_raw_oral, is.numeric, logical(1))))

cat("口腔原始 ASV 数量：", nrow(asv_raw_oral), "\n")
cat("口腔原始样本数量：", ncol(asv_raw_oral), "\n")

# =========================================================
# 2. 严格二值化过滤 (Min 2 reads, Min 2 samples)
# =========================================================
# 规则：单个样本中 count >= 2 才视为有效检出
asv_bin_all_oral <- t(as.matrix(asv_raw_oral)) >= 2

# 保留在至少 2 个样本中达到 count >= 2 的 ASV (剔除 Singletons/Doubletons 噪声)
keep_asv_oral <- colSums(asv_bin_all_oral) >= 2
asv_clean_oral <- asv_raw_oral[keep_asv_oral, , drop = FALSE]

cat("过滤后保留的口腔 ASV 数量：", nrow(asv_clean_oral), "\n")

# 保存过滤后的口腔 ASV 表 (备用)
write.table( asv_clean_oral,file = "Output/oral_ASV_filter_counts_min2reads_min2samples.txt",sep = "\t",quote = FALSE,col.names = NA)

# =========================================================
# 3. 极速矩阵乘法计算口腔两两 ASV 共享 (tcrossprod)
# =========================================================
# 最终二值逻辑矩阵：行 = 样本，列 = ASV
asv_bin_oral   <- t(as.matrix(asv_clean_oral)) >= 2
sample_vec_oral <- rownames(asv_bin_oral)
total_sample_oral <- nrow(asv_bin_oral)

cat("进入口腔共享分析的样本数量：", total_sample_oral, "\n")
cat("理论配对数量：", choose(total_sample_oral, 2), "\n")

# 计算各样本 Richness
richness_vec_oral <- rowSums(asv_bin_oral)

# 创建空的 N x N 共享矩阵
shared_mat_oral <- matrix(
  0, 
  nrow = total_sample_oral, 
  ncol = total_sample_oral, 
  dimnames = list(sample_vec_oral, sample_vec_oral)
)

# 分块计算 (每次 500 条 ASV，省内存且调用底层 BLAS 矩阵乘法极速运算)
block_size <- 500L
start_vec  <- seq.int(from = 1L, to = ncol(asv_bin_oral), by = block_size)

for (start_col in start_vec) {
  end_col <- min(start_col + block_size - 1L, ncol(asv_bin_oral))
  
  # 提取小块并转为 double 类型
  block <- asv_bin_oral[, start_col:end_col, drop = FALSE]
  storage.mode(block) <- "double"
  
  # 矩阵乘法累加交集: Block %*% t(Block)
  shared_mat_oral <- shared_mat_oral + tcrossprod(block)
  
  rm(block)
  gc(FALSE)
}

# =========================================================
# 4. 提取上三角矩阵 (绝对无方向，A-B 仅保留 1 次) 并构建 share_df_oral
# =========================================================
pair_idx_oral      <- which(upper.tri(shared_mat_oral), arr.ind = TRUE)
shared_vec_oral    <- shared_mat_oral[pair_idx_oral]
richness1_vec_oral <- richness_vec_oral[pair_idx_oral[, 1]]
richness2_vec_oral <- richness_vec_oral[pair_idx_oral[, 2]]

# 容斥原理计算并集: Union = A + B - Intersect
union_vec_oral     <- richness1_vec_oral + richness2_vec_oral - shared_vec_oral

# 构建口腔最终结果表
share_df_oral <- tibble(
  Sample1        = sample_vec_oral[pair_idx_oral[, 1]],
  Sample2        = sample_vec_oral[pair_idx_oral[, 2]],
  Richness1      = as.integer(richness1_vec_oral),
  Richness2      = as.integer(richness2_vec_oral),
  Shared_ASV     = as.integer(shared_vec_oral),
  Union_ASV      = as.integer(union_vec_oral),
  ASV_share_rate = ifelse(union_vec_oral == 0, NA_real_, (shared_vec_oral / union_vec_oral) * 100)
)

# 清理无用大对象，释放内存
rm(asv_raw_oral, asv_bin_all_oral, asv_clean_oral, asv_bin_oral, 
   shared_mat_oral, pair_idx_oral, shared_vec_oral, union_vec_oral, 
   richness1_vec_oral, richness2_vec_oral, richness_vec_oral)
gc()

# =========================================================
# 5. 检查计算结果
# =========================================================
cat("--- 口腔 ASV 共享率计算完成 --- \n")
cat("共计算配对数：", nrow(share_df_oral), "\n")
head(share_df_oral)
