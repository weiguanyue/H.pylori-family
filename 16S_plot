plot_parent_hp <- function(family_pairs, site_name) {
    
    # ----------------------------------------------------------
    # 1. 构建三个分析panel
    # ----------------------------------------------------------
    parent_base <- family_pairs %>%
        filter(Relationship %in% c("Mother–offspring", "Father–offspring")) %>%
        mutate(Hp_Pair3 = factor(Hp_Pair3, levels = c("NN", "PN", "PP")))
    
    plot_df <- bind_rows(
        parent_base %>% mutate(Panel = "Parent–offspring"),
        parent_base %>% filter(Relationship == "Mother–offspring") %>% mutate(Panel = "Mother–offspring"),
        parent_base %>% filter(Relationship == "Father–offspring") %>% mutate(Panel = "Father–offspring")
    ) %>%
        mutate(Panel = factor(Panel, levels = c("Parent–offspring", "Mother–offspring", "Father–offspring")),
               Hp_Positive_N = case_when(Hp_Pair3 == "NN" ~ 0, Hp_Pair3 == "PN" ~ 1, Hp_Pair3 == "PP" ~ 2))
    
    # ----------------------------------------------------------
    # 2. Print每组样本量
    # ----------------------------------------------------------
    cat("\n====================================================\n")
    cat(site_name, ": sample size\n")
    cat("====================================================\n")
    print(plot_df %>% count(Panel, Hp_Pair3) %>% pivot_wider(names_from = Hp_Pair3, values_from = n, values_fill = 0))
    
    # ----------------------------------------------------------
    # 3. Print每组中位数和IQR
    # ----------------------------------------------------------
    cat("\n", site_name, ": median and IQR\n", sep = "")
    summary_df <- plot_df %>%
        group_by(Panel, Hp_Pair3) %>%
        summarise(n = n(), median = median(ASV_share_rate, na.rm = TRUE),
                  Q1 = quantile(ASV_share_rate, 0.25, na.rm = TRUE),
                  Q3 = quantile(ASV_share_rate, 0.75, na.rm = TRUE), .groups = "drop")
    print(summary_df)
    
    # ----------------------------------------------------------
    # 4. 两两Wilcoxon：NN vs PN / NN vs PP / PN vs PP
    #    这里先报告raw P，不做多重校正
    # ----------------------------------------------------------
    pairwise_p <- plot_df %>%
        group_by(Panel) %>%
        group_modify(~{
            map_dfr(pair_comparisons, function(cp) {
                x <- .x %>% filter(Hp_Pair3 == cp[1]) %>% pull(ASV_share_rate)
                y <- .x %>% filter(Hp_Pair3 == cp[2]) %>% pull(ASV_share_rate)
                wt <- wilcox.test(x, y, exact = FALSE)
                tibble(comparison = paste(cp[1], "vs", cp[2]), p_value = wt$p.value)
            })
        }) %>%
        ungroup()
    
    cat("\n", site_name, ": pairwise Wilcoxon P values\n", sep = "")
    print(pairwise_p)
    
    # ----------------------------------------------------------
    # 5. Jonckheere-Terpstra趋势检验：NN < PN < PP
    # ----------------------------------------------------------
    trend_p <- plot_df %>%
        group_by(Panel) %>%
        group_modify(~{
            jt <- suppressWarnings(jonckheere.test(.x$ASV_share_rate, .x$Hp_Positive_N, alternative = "increasing"))
            tibble(P_trend = jt$p.value)
        }) %>%
        ungroup()
    
    cat("\n", site_name, ": Jonckheere-Terpstra P for trend\n", sep = "")
    print(trend_p)
    
    # ----------------------------------------------------------
    # 6. 为图上的P for trend准备位置
    # ----------------------------------------------------------
    trend_label <- plot_df %>%
        group_by(Panel) %>%
        summarise(y = max(ASV_share_rate, na.rm = TRUE) * 1.36, .groups = "drop") %>%
        left_join(trend_p, by = "Panel") %>%
        mutate(x = 2, label = paste0("P for trend = ", format.pval(P_trend, digits = 3, eps = 0.001)))
    
    # ----------------------------------------------------------
    # 7. 作图
    # ----------------------------------------------------------
    p <- ggplot(plot_df, aes(x = Hp_Pair3, y = ASV_share_rate, fill = Hp_Pair3, color = Hp_Pair3)) +
        geom_violin(width = 0.65, alpha = 0.60, linewidth = 0.4, trim = TRUE) +
        geom_boxplot(width = 0.14, alpha = 0.85, outlier.shape = NA, linewidth = 0.4, color = "#444444") +
        stat_compare_means(comparisons = pair_comparisons, method = "wilcox.test", label = "p.format") +
        geom_text(data = trend_label, aes(x = x, y = y, label = label), inherit.aes = FALSE,
                  size = 3.7, fontface = "bold") +
        facet_wrap(~Panel, nrow = 1) +
        scale_fill_manual(values = col_hp) +
        scale_color_manual(values = col_hp) +
        labs(title = site_name, x = NULL, y = "ASV-sharing rate (%)") +
        theme_bw(base_size = 12) +
        theme(panel.grid = element_blank(), legend.position = "none",
              strip.text = element_text(size = 11, face = "bold"),
              plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
              axis.text.x = element_text(size = 10, color = "black"),
              axis.text.y = element_text(size = 10, color = "black"),
              axis.title.y = element_text(size = 11, face = "bold"))
    
    return(list(plot = p, summary = summary_df, pairwise_p = pairwise_p, trend_p = trend_p, data = plot_df))
}


